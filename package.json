{
  "name": "@crayonlu/agent-man",
  "version": "0.2.0",
  "description": "Safe Git-backed synchronization for native AI agent configuration surfaces",
  "type": "module",
  "bin": {
    "agent-man": "./dist/src/cli.js"
  },
  "files": [
    ".agents/skills/agent-man",
    "dist/src",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:grok": "npm run build && node scripts/check-grok.mjs",
    "format": "prettier --write . && tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check . && tsc -p tsconfig.json --noEmit",
    "install:check": "node scripts/check-install.mjs",
    "install:check:github": "node scripts/check-install.mjs --github",
    "pack:check": "npm pack --dry-run",
    "prepare": "npm run build",
    "smoke": "npm run build && node dist/src/cli.js --help",
    "template:export": "node scripts/export-template.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crayonlu/agent-man.git"
  },
  "bugs": {
    "url": "https://github.com/crayonlu/agent-man/issues"
  },
  "homepage": "https://github.com/crayonlu/agent-man#readme",
  "keywords": [
    "ai-agent",
    "cli",
    "configuration",
    "git",
    "grok",
    "skills"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.13.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
